<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="24dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <TextView
            android:id="@+id/textViewCompareTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Kuntien vertailu"
            android:textSize="20sp"
            android:textStyle="bold" />

        <EditText
            android:id="@+id/editTextCompareMunicipalityOne"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:hint="Ensimmäinen kunta"
            android:inputType="text"
            android:minHeight="48dp" />

        <EditText
            android:id="@+id/editTextCompareMunicipalityTwo"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:hint="Toinen kunta"
            android:inputType="text"
            android:minHeight="48dp" />

        <Button
            android:id="@+id/buttonCompare"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="Vertaa kuntia" />

        <TextView
            android:id="@+id/textViewCompareResult"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="Vertailun tulokset näkyvät tässä"
            android:textSize="15sp" />

    </LinearLayout>

</ScrollView>